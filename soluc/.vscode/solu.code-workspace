{
    "folders": [{
        "name": "Solu",
        "path": "../",
    }],
    "settings": {
        "rust-analyzer.debug.engine": "llvm-vs-code-extensions.lldb-dap",
        "rust-analyzer.debug.engineSettings": {
            "setupCommands": [{
                "description": "Enable pretty-printing for lldb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": false,
            }]
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Cargo Build Dev",
                "command": "cargo build",
                "type": "shell",
                "args": [],
                "problemMatcher": [
                    "$rustc"
                ],
                "presentation": {
                    "reveal": "always"
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Rust",
                "type": "lldb",
                "request": "launch",
                "program": "${workspaceFolder}/target/debug/dvmc",
                "args": ["../examples/syntax.sl"],
                "cwd": "${workspaceFolder}",
                "initCommands": [
                    "command script import \"${env:HOME}/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/etc/lldb_lookup.py\""
                ],
                "sourceLanguages": ["rust"],
                "preLaunchTask": "Cargo Build Dev"
            }
        ],
        "compounds": []
    }
}